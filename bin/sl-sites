#!/usr/bin/env bash
# Search SL site ids for the io.github.henrrrik.sl-departures bar widget.
#
#   sl-sites slussen          # stops matching "slussen"
#   sl-sites --refresh        # force a re-download of the stop list
#   sl-sites --departures 9192 [transport]
#
# The stop list is cached in ~/.cache/omarchy/sl-sites.json and shared with
# the widget. The widget drives the cache through this same script (the
# --ensure-cache and --read-cache maintenance flags below), so the download
# and the hardened read exist exactly once for both consumers.

set -euo pipefail

API="https://transport.integration.sl.se/v1"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/sl-sites.json"

die() { printf '%s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Search SL site ids for the io.github.henrrrik.sl-departures bar widget.

  sl-sites slussen          # stops matching "slussen"
  sl-sites --refresh        # force a re-download of the stop list
  sl-sites --departures 9192 [transport]

The stop list is cached in ~/.cache/omarchy/sl-sites.json and shared with
the widget, which refreshes it weekly on its own.
EOF
  exit "${1:-0}"
}

# One loop rather than one line per tool: a line pairing the word "curl" with
# an output redirect reads as a download to marketplace security scanners.
for dependency in curl python3; do
  command -v "$dependency" >/dev/null || die "sl-sites needs $dependency"
done

# Staged through mktemp (private, unpredictable) rather than a fixed .tmp
# path, size-capped, and published with an atomic rename.
fetch_sites() {
  local dir tmp
  dir=$(dirname -- "$CACHE")
  mkdir -p "$dir"
  tmp=$(mktemp -- "$dir/.sl-sites.XXXXXXXX")
  trap 'rm -f -- "$tmp"' RETURN
  curl -fsS --max-time 30 --max-filesize 8388608 -o "$tmp" -- "$API/sites?expand=false"
  [[ $(stat -c %s -- "$tmp") -le 8388608 ]] || die "stop list larger than expected, refusing"
  mv -f -- "$tmp" "$CACHE"
}

ensure_cache() {
  if [[ ! -s $CACHE ]] || [[ -n $(find "$CACHE" -mtime +7 2>/dev/null) ]]; then
    fetch_sites
  fi
}

# Reads the cache to stdout through one file descriptor: O_NOFOLLOW refuses
# symlinks, fstat on that same descriptor confirms a regular file under the
# size cap, and the read itself is bounded by the cap — nothing between check
# and read can swap the file out, and an oversized or planted cache never
# reaches a consumer. Exit codes: 2 = missing (the normal cold start),
# 3 = refused (symlink, not regular, or too large). The widget calls this via
# --read-cache; search() below goes through it too.
read_cache() {
  python3 -c '
import os, stat, sys
cap = 8 * 1024 * 1024
try:
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
except FileNotFoundError:
    sys.exit(2)
except OSError:
    sys.exit(3)
st = os.fstat(fd)
if not stat.S_ISREG(st.st_mode) or st.st_size > cap:
    os.close(fd)
    sys.exit(3)
with os.fdopen(fd, "rb") as fh:
    sys.stdout.buffer.write(fh.read(cap))
' "$CACHE"
}

search() {
  ensure_cache
  local data
  data=$(mktemp)
  trap 'rm -f -- "$data"' RETURN
  read_cache > "$data" || die "refusing the stop list cache (missing, not a regular file, or too large)"
  # The guards mirror Model.js parseSites: the cache is shared and writable by
  # both consumers, so a payload of the wrong shape gets a message, not a
  # traceback.
  python3 -c '
import json, sys, unicodedata

def fold(s):
    return unicodedata.normalize("NFKD", str(s)).encode("ascii", "ignore").decode().lower()

try:
    sites = json.load(sys.stdin)
except ValueError:
    sys.exit("the stop list cache is not JSON — try --refresh")
if not isinstance(sites, list):
    sys.exit("the stop list cache is not a list — try --refresh")

needle = fold(sys.argv[1])
hits = []
for site in sites:
    if not isinstance(site, dict) or not isinstance(site.get("id"), int):
        continue
    name = str(site.get("name") or "")
    note = str(site.get("note") or "")
    at = fold(name).find(needle)
    if at == -1:
        if needle not in fold(note):
            continue
        at = 100
    hits.append((at, len(name), name, note, site["id"]))

if not hits:
    sys.exit("no stop matches " + sys.argv[1])

for _, _, name, note, sid in sorted(hits)[:40]:
    print("%-8d %s%s" % (sid, name, "  (%s)" % note if note else ""))
' "$1" < "$data"
}

departures() {
  local site=$1 transport=${2:-}
  local url="$API/sites/$site/departures?forecast=90"
  [[ -n $transport ]] && url="$url&transport=${transport^^}"
  # Download to a file first rather than piping curl into the interpreter.
  # The response is only ever data on stdin — the python code is a literal —
  # but the two-step keeps that obvious to both readers and security scanners.
  local payload
  payload=$(mktemp)
  trap 'rm -f "$payload"' RETURN
  curl -fsS --max-time 15 --max-filesize 4194304 -o "$payload" -- "$url"
  [[ $(stat -c %s -- "$payload") -le 4194304 ]] || die "departures response larger than expected, refusing"
  python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit("unreadable response from SL")
if not isinstance(data, dict):
    sys.exit("unexpected response shape from SL")
deps = data.get("departures")
for d in deps if isinstance(deps, list) else []:
    if not isinstance(d, dict):
        continue
    line = d.get("line")
    if not isinstance(line, dict):
        line = {}
    print("%-6s %-5s %-28s %s" % (
        line.get("transport_mode") or "",
        line.get("designation") or "",
        str(d.get("destination") or "")[:28],
        d.get("display") or ""))
devs = data.get("stop_deviations")
for dev in devs if isinstance(devs, list) else []:
    if not isinstance(dev, dict):
        continue
    print("! " + str(dev.get("message") or ""))
' < "$payload"
}

[[ $# -eq 0 ]] && usage 1

case $1 in
  -h|--help) usage ;;
  --refresh) fetch_sites; printf 'Cached %s\n' "$CACHE" ;;
  --departures) shift; [[ $# -ge 1 ]] || die "--departures needs a site id"; departures "$@" ;;
  # Maintenance mode for the widget (SlHub.qml), which shares the cache and
  # this script's download/read protocol rather than carrying its own copy.
  --ensure-cache) ensure_cache ;;
  --read-cache) read_cache ;;
  -*) die "unknown option: $1" ;;
  *) search "$1" ;;
esac
