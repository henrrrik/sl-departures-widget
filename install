#!/usr/bin/env bash
# Copy this checkout into the Omarchy plugin directory and reload the shell.
#
# A copy, not a symlink: the shell's plugin watcher does not follow symlinks,
# so a symlinked plugin never hot-reloads and can serve stale compiled QML.

set -euo pipefail

id=io.github.henrrrik.sl-departures
src=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dest="$HOME/.config/omarchy/plugins/$id"

# Mirror the whole checkout minus the repository's own scaffolding, so a new
# QML file is never left behind by a hand-maintained file list.
mkdir -p "$dest"
if command -v rsync >/dev/null; then
  rsync -a --delete \
    --exclude '.git' --exclude '.gitignore' --exclude 'install' --exclude 'README.md' --exclude 'preview.png' \
    "$src/" "$dest/"
else
  rm -rf "${dest:?}"/*
  for path in "$src"/*; do
    case ${path##*/} in
      .git|.gitignore|install|README.md|preview.png) continue ;;
    esac
    cp -r "$path" "$dest/"
  done
fi
printf 'Installed %s -> %s\n' "$id" "$dest"

if omarchy-shell shell ping >/dev/null 2>&1; then
  omarchy restart shell >/dev/null 2>&1 || true
  printf 'Shell restarted.\n'
fi

printf 'Enable it with: omarchy plugin enable %s --section center\n' "$id"
